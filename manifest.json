{
  "manifest_version": 3,
  "name": "Live Translator for YouTube",
  "version": "0.5.3",
  "description": "Real-time translated YouTube Live subtitles with FluidAudio diarization, Gemma 4 E4B smart translation, Qwen3-ASR, and Deepgram fallback.",
  "minimum_chrome_version": "138",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.deepgram.com/*",
    "wss://api.deepgram.com/*",
    "http://127.0.0.1:8765/*",
    "ws://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Live Translator"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen/pcm-worklet.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
